{
  "name": "eva-commerce",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n storefront,admin,api -c auto \"npm run dev -w @eva/storefront\" \"npm run dev -w @eva/admin\" \"npm run dev -w @eva/api\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate -w @eva/api",
    "db:migrate": "npm run db:migrate -w @eva/api",
    "db:studio": "npm run db:studio -w @eva/api"
  },
  "overrides": {
    "@aws-sdk/core": "3.916.0",
    "@aws-sdk/credential-provider-env": "3.916.0",
    "@aws-sdk/credential-provider-http": "3.916.0",
    "@aws-sdk/credential-provider-ini": "3.918.0",
    "@aws-sdk/credential-provider-node": "3.918.0",
    "@aws-sdk/credential-provider-process": "3.916.0",
    "@aws-sdk/credential-provider-sso": "3.916.0",
    "@aws-sdk/credential-provider-web-identity": "3.918.0",
    "@aws-sdk/nested-clients": "3.916.0",
    "@aws-sdk/types": "3.914.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  }
}
