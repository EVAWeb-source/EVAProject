{
  "name": "@eva/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate --schema prisma/schema.prisma && nest build",
    "start": "prisma db push --config prisma7.config.ts && node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:studio": "prisma studio --config prisma7.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.35.0",
    "prisma": "^7.10.0",
    "typescript": "^5.9.2"
  }
}