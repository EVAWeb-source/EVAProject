generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  HIDDEN
  DISCONTINUED
  ARCHIVED
}

enum UnitStatus {
  QC_PENDING
  AVAILABLE
  RESERVED
  SOLD
  RETURNED
  QUALITY_HOLD
  DAMAGED
  UNAVAILABLE
}

enum OrderStatus {
  DEMO_CONFIRMED
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  RELEASED
}

model Collection {
  id        String          @id @default(cuid())
  nameFa    String
  slug      String          @unique
  code      String          @unique
  story     String?
  products  MasterProduct[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model MasterProduct {
  id           String          @id @default(cuid())
  nameFa       String
  slug         String          @unique
  masterSku    String          @unique
  purity       Int             @default(18)
  status       ProductStatus   @default(DRAFT)
  collectionId String?
  collection   Collection?     @relation(fields: [collectionId], references: [id])
  units        PhysicalUnit[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status])
  @@index([collectionId])
}

model PhysicalUnit {
  id                String        @id @default(cuid())
  unitSku           String        @unique
  productId         String
  product           MasterProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  exactWeightGram   Decimal       @db.Decimal(8, 3)
  currentPriceToman BigInt?
  status            UnitStatus    @default(QC_PENDING)
  reservedUntil     DateTime?
  orderLines        OrderLine[]
  reservations      Reservation[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([productId, status])
  @@index([status, reservedUntil])
}

model GoldRate {
  id          String   @id @default(cuid())
  purity      Int      @default(18)
  irrPerGram  BigInt
  source      String
  rateVersion String   @unique
  observedAt  DateTime
  createdAt   DateTime @default(now())

  @@index([purity, observedAt])
}

model PricingRule {
  id             String   @id
  name           String
  formulaVersion String   @unique
  makingPercent  Decimal  @db.Decimal(7, 3)
  profitPercent  Decimal  @db.Decimal(7, 3)
  taxPercent     Decimal  @db.Decimal(7, 3)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, updatedAt])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  status        OrderStatus @default(DEMO_CONFIRMED)
  isDemo        Boolean     @default(true)
  customerName  String
  mobile        String
  province      String
  city          String
  address       String
  postalCode    String
  recipientName String
  totalToman    BigInt
  lines         OrderLine[]
  reservation   Reservation?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([mobile, createdAt])
  @@index([status, createdAt])
}

model OrderLine {
  id                       String       @id @default(cuid())
  orderId                  String
  order                    Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  unitId                   String
  unit                     PhysicalUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  productNameFa            String
  masterSku                String
  unitSku                  String
  exactWeightGram          Decimal      @db.Decimal(8, 3)
  purity                   Int
  unitPriceToman           BigInt
  goldRateTomanPerGram     BigInt?
  goldValueToman           BigInt?
  makingToman              BigInt?
  profitToman              BigInt?
  taxToman                 BigInt?
  rateVersion              String?
  pricingFormulaVersion    String?
  pricingRuleId            String?
  createdAt                DateTime     @default(now())

  @@index([orderId])
  @@index([unitId])
}

model Reservation {
  id                    String            @id @default(cuid())
  token                 String            @unique
  unitId                String
  unit                  PhysicalUnit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  status                ReservationStatus @default(ACTIVE)
  expiresAt             DateTime
  lockedPriceToman      BigInt?
  goldRateTomanPerGram  BigInt?
  goldValueToman        BigInt?
  makingToman           BigInt?
  profitToman           BigInt?
  taxToman              BigInt?
  rateVersion           String?
  pricingFormulaVersion String?
  pricingRuleId         String?
  orderId               String?           @unique
  order                 Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([unitId, status, expiresAt])
  @@index([status, expiresAt])
}
