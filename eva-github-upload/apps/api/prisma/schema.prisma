generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  HIDDEN
  DISCONTINUED
  ARCHIVED
}

enum UnitStatus {
  QC_PENDING
  AVAILABLE
  RESERVED
  SOLD
  RETURNED
  QUALITY_HOLD
  DAMAGED
  UNAVAILABLE
}

enum OrderStatus {
  DEMO_CONFIRMED
  PENDING_PAYMENT
  PAID
  REFUND_PENDING
  REFUNDED
  CANCELLED
}

enum FulfillmentStatus {
  REGISTERED
  PREPARING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  RELEASED
  COMPLETED
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  REFUNDED
  FAILED
  EXPIRED
}

enum InvoiceStatus {
  ISSUED
  VOID
}

enum ProductImageRole {
  MAIN
  GALLERY
  ON_BODY
  DETAIL
}

enum AfterSalesType {
  CANCELLATION
  RETURN
}

enum AfterSalesStatus {
  REQUESTED
  RETURN_IN_TRANSIT
  QC_PENDING
  REFUND_PENDING
  COMPLETED
  REJECTED
}

model Collection {
  id        String          @id @default(cuid())
  nameFa    String
  slug      String          @unique
  code      String          @unique
  story     String?
  products  MasterProduct[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model MasterProduct {
  id               String          @id @default(cuid())
  nameFa           String
  slug             String          @unique
  masterSku        String          @unique
  purity           Int             @default(18)
  status           ProductStatus   @default(DRAFT)
  collectionId     String?
  collection       Collection?     @relation(fields: [collectionId], references: [id])
  shortDescription String?
  story            String?
  goldColor        String?
  styleLabel       String?
  details          String?
  dimensions       String?
  sizeGuide        String?
  careInstructions String?
  packagingNote    String?
  seoTitle         String?
  seoDescription   String?
  images           ProductImage[]
  units            PhysicalUnit[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
  @@index([collectionId])
}

model ProductImage {
  id        String           @id @default(cuid())
  productId String
  product   MasterProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String
  role      ProductImageRole @default(GALLERY)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([productId, sortOrder])
  @@index([productId, role])
}

model PhysicalUnit {
  id                String           @id @default(cuid())
  unitSku           String           @unique
  productId         String
  product           MasterProduct    @relation(fields: [productId], references: [id], onDelete: Restrict)
  exactWeightGram   Decimal          @db.Decimal(8, 3)
  currentPriceToman BigInt?
  status            UnitStatus       @default(QC_PENDING)
  reservedUntil     DateTime?
  orderLines        OrderLine[]
  reservations      Reservation[]
  afterSalesCases   AfterSalesCase[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([productId, status])
  @@index([status, reservedUntil])
}

model GoldRate {
  id          String   @id @default(cuid())
  purity      Int      @default(18)
  irrPerGram  BigInt
  source      String
  rateVersion String   @unique
  observedAt  DateTime
  createdAt   DateTime @default(now())

  @@index([purity, observedAt])
}

model PricingRule {
  id             String   @id
  name           String
  formulaVersion String   @unique
  makingPercent  Decimal  @db.Decimal(7, 3)
  profitPercent  Decimal  @db.Decimal(7, 3)
  taxPercent     Decimal  @db.Decimal(7, 3)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, updatedAt])
}

model Customer {
  id           String   @id @default(cuid())
  mobile       String   @unique
  name         String?
  internalNote String?
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique
  status            OrderStatus       @default(PENDING_PAYMENT)
  fulfillmentStatus FulfillmentStatus @default(REGISTERED)
  isDemo            Boolean           @default(true)
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String
  mobile            String
  province          String
  city              String
  address            String
  postalCode        String
  recipientName     String
  shippingCarrier   String?
  trackingCode      String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  totalToman        BigInt
  lines             OrderLine[]
  reservation       Reservation?
  payments          PaymentAttempt[]
  invoice           Invoice?
  afterSalesCases   AfterSalesCase[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([customerId, createdAt])
  @@index([mobile, createdAt])
  @@index([status, createdAt])
  @@index([fulfillmentStatus, createdAt])
}

model OrderLine {
  id                       String       @id @default(cuid())
  orderId                  String
  order                    Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  unitId                   String
  unit                     PhysicalUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  productNameFa            String
  masterSku                String
  unitSku                  String
  exactWeightGram          Decimal      @db.Decimal(8, 3)
  purity                   Int
  unitPriceToman           BigInt
  goldRateTomanPerGram     BigInt?
  goldValueToman           BigInt?
  makingToman              BigInt?
  profitToman              BigInt?
  taxToman                 BigInt?
  rateVersion              String?
  pricingFormulaVersion    String?
  pricingRuleId            String?
  createdAt                DateTime     @default(now())

  @@index([orderId])
  @@index([unitId])
}

model Reservation {
  id                    String            @id @default(cuid())
  token                 String            @unique
  unitId                String
  unit                  PhysicalUnit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  status                ReservationStatus @default(ACTIVE)
  expiresAt             DateTime
  lockedPriceToman      BigInt?
  goldRateTomanPerGram  BigInt?
  goldValueToman        BigInt?
  makingToman           BigInt?
  profitToman           BigInt?
  taxToman              BigInt?
  rateVersion           String?
  pricingFormulaVersion String?
  pricingRuleId         String?
  orderId               String?           @unique
  order                 Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([unitId, status, expiresAt])
  @@index([status, expiresAt])
}

model PaymentAttempt {
  id           String        @id @default(cuid())
  token        String        @unique
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider     String        @default("DEMO")
  status       PaymentStatus @default(INITIATED)
  amountToman  BigInt
  referenceId  String?       @unique
  failureCode  String?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([orderId, status])
  @@index([status, createdAt])
}

model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique
  verificationCode String        @unique
  status           InvoiceStatus @default(ISSUED)
  orderId          String        @unique
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerName       String        @default("EVA")
  customerName     String
  customerMobile   String
  recipientName    String
  province         String
  city             String
  address          String
  postalCode       String
  paymentProvider  String
  paymentReference String
  totalToman       BigInt
  lines            InvoiceLine[]
  issuedAt         DateTime      @default(now())
  createdAt        DateTime      @default(now())

  @@index([status, issuedAt])
  @@index([customerMobile, issuedAt])
}

model InvoiceLine {
  id                    String   @id @default(cuid())
  invoiceId             String
  invoice               Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  productNameFa         String
  masterSku             String
  unitSku               String
  exactWeightGram       Decimal  @db.Decimal(8, 3)
  purity                 Int
  goldRateTomanPerGram  BigInt?
  goldValueToman        BigInt?
  makingToman           BigInt?
  profitToman           BigInt?
  taxToman              BigInt?
  finalPriceToman       BigInt
  rateVersion           String?
  pricingFormulaVersion String?
  pricingRuleId         String?
  createdAt             DateTime @default(now())

  @@index([invoiceId])
  @@index([unitSku])
}

model AfterSalesCase {
  id                String           @id @default(cuid())
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  unitId            String
  unit              PhysicalUnit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  type              AfterSalesType
  status            AfterSalesStatus @default(REQUESTED)
  reason            String
  note              String?
  refundAmountToman BigInt?
  refundReference   String?
  qcOutcome         UnitStatus?
  requestedAt       DateTime         @default(now())
  approvedAt        DateTime?
  receivedAt        DateTime?
  qcCompletedAt     DateTime?
  refundedAt        DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([orderId, createdAt])
  @@index([unitId, createdAt])
  @@index([type, status, createdAt])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  mobile     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([mobile, createdAt])
  @@index([mobile, expiresAt])
}

model CustomerSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  mobile     String
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([mobile, expiresAt])
}

model SmsNotification {
  id          String   @id @default(cuid())
  orderId     String?
  orderNumber String?
  mobile      String
  event       String
  body        String
  provider    String   @default("NOT_CONFIGURED")
  status      String   @default("PENDING_PROVIDER")
  providerRef String?
  error       String?
  createdAt   DateTime @default(now())
  sentAt      DateTime?

  @@index([orderNumber, createdAt])
  @@index([mobile, createdAt])
  @@index([status, createdAt])
}