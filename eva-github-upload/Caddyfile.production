eva-gold.ir {
  encode zstd gzip

  @api path /api/v1/*
  handle @api {
    reverse_proxy api:4000
  }

  handle {
    reverse_proxy storefront:3000
  }
}

www.eva-gold.ir {
  redir https://eva-gold.ir{uri} permanent
}

admin.eva-gold.ir {
  encode zstd gzip

  tls {
    issuer acme https://acme.zerossl.com/v2/DV90 {
      email {$ACME_EMAIL}
    }
  }

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }

  reverse_proxy admin:3001
}
