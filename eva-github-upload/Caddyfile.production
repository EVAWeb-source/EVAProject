eva-gold.ir {
  encode zstd gzip

  @api path /api/v1/*
  handle @api {
    reverse_proxy api:4000
  }

  handle {
    reverse_proxy storefront:3000
  }
}

www.eva-gold.ir {
  redir https://eva-gold.ir{uri} permanent
}

admin.eva-gold.ir {
  encode zstd gzip

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }

  reverse_proxy admin:3001
}

https://eva-gold.ir:8443 {
  encode zstd gzip

  tls /data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/eva-gold.ir/eva-gold.ir.crt /data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/eva-gold.ir/eva-gold.ir.key

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }

  reverse_proxy admin:3001
}
